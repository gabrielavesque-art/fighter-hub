+/* ═══════════ MON COMPTE ═══════════
+   Un profil sans serveur : pseudo, combattants suivis, soirées suivies et une
+   prime quotidienne, tous rangés dans le même objet PN que les pronostics.
+   Rien de nouveau n'est stocké, rien n'est envoyé nulle part.
+
+   HORLOGE — la prime ne peut pas croire l'horloge du visiteur : avancer la date
+   de sa machine suffirait à la réclamer en boucle. Chaque réponse HTTP porte un
+   en-tête `Date` posé par le serveur ; on mesure l'écart une fois au chargement
+   et tout ce qui touche à la prime passe par fhNow(). Sans cette mesure, la
+   prime est refusée plutôt qu'accordée sur une base invérifiable.
+
+   Ce que ça n'arrête PAS : éditer soi-même son localStorage. Aucun code côté
+   navigateur ne peut l'empêcher — il faudrait de vrais comptes et un serveur
+   qui tienne le solde. D'où la séparation nette : tout passe par fhClaim() et
+   pnSave(), les deux seuls points à rebrancher le jour venu. */
+let FH_SKEW = 0;                 // ms à ajouter à l'horloge locale pour retomber sur celle du serveur
+let FH_SYNCED = false;
+async function fhSyncClock(){
+  try{
+    // no-store + paramètre unique : une réponse servie par le cache porterait
+    // la date de sa mise en cache, pas celle de maintenant
+    const r = await fetch('?_h=' + Date.now(), { method:'HEAD', cache:'no-store' });
+    const t = Date.parse(r.headers.get('date') || '');
+    if(!isNaN(t)){ FH_SKEW = t - Date.now(); FH_SYNCED = true; }
+  }catch(e){ console.warn('[compte] horloge serveur injoignable :', e.message); }
+}
+function fhNow(){ return Date.now() + FH_SKEW; }
+// Jour civil UTC : un repère unique pour tout le monde. En jour local, changer
+// de fuseau déclaré rejouerait la prime sans même toucher à la date.
+function fhDay(ts){ return new Date(ts === undefined ? fhNow() : ts).toISOString().slice(0,10); }
+function fhDayDiff(a, b){ return Math.round((Date.parse(b+'T00:00:00Z') - Date.parse(a+'T00:00:00Z')) / PN_DAY); }
+
+/* ── prime quotidienne : 50 crédits, +5 par jour consécutif ──────────────── */
+const FH_CLAIM_BASE = 50;    // le premier jour
+const FH_CLAIM_STEP = 5;     // chaque jour d'affilée en plus
+// Plafond : sans lui la série devient la principale source de revenus (J60 =
+// 345 cr/jour) et la bankroll ne veut plus rien dire. À J11 la prime double
+// déjà la mise de départ — c'est assez pour récompenser l'assiduité.
+const FH_CLAIM_CAP  = 100;
+function fhAmountFor(streak){
+  return Math.min(FH_CLAIM_CAP, FH_CLAIM_BASE + FH_CLAIM_STEP * Math.max(0, streak - 1));
